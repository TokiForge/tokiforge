{
  "name": "tokiforge",
  "version": "2.2.3",
  "type": "module",
  "description": "Framework-agnostic design token and theming engine for React, Vue, Svelte, Angular, Next.js, Remix, and more. Runtime theme switching, CSS variables, TypeScript support, dark mode, accessibility features, and <3KB gzipped. Perfect for design systems and multi-framework projects.",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*",
    "documentation",
    "examples/plugin-examples"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "build": "npm run build:core && npm run build:rest",
    "build:core": "npm run build --workspace @tokiforge/core",
    "build:vue": "pnpm --filter @tokiforge/vue run build",
    "build:rest": "npm run build --workspace @tokiforge/react --workspace @tokiforge/vue --workspace @tokiforge/svelte --workspace @tokiforge/angular --workspace @tokiforge/tailwind --workspace @tokiforge/figma --workspace tokiforge-cli",
    "build:all": "npm run build --workspace @tokiforge/core --workspace @tokiforge/react --workspace @tokiforge/vue --workspace @tokiforge/svelte --workspace @tokiforge/angular --workspace @tokiforge/tailwind --workspace @tokiforge/figma --workspace tokiforge-cli --workspace @tokiforge/playground --workspace TokiForge-docs",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "clean:all": "npm run clean --workspaces && rm -rf node_modules .tsbuildinfo",
    "docs:dev": "npm run dev --workspace TokiForge-docs",
    "docs:build": "npm run build --workspace TokiForge-docs",
    "docs:preview": "npm run preview --workspace TokiForge-docs",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "install:global": "cd packages/cli && pnpm run build && pnpm install -g .",
    "uninstall:global": "pnpm uninstall -g tokiforge-cli",
    "publish:core": "cd packages/core && pnpm publish --access public",
    "publish:react": "cd packages/react && pnpm publish --access public",
    "publish:vue": "cd packages/vue && pnpm publish --access public",
    "publish:svelte": "cd packages/svelte && pnpm publish --access public",
    "publish:angular": "cd packages/angular && pnpm publish --access public",
    "publish:tailwind": "cd packages/tailwind && pnpm publish --access public",
    "publish:figma": "cd packages/figma && pnpm publish --access public",
    "publish:cli": "cd packages/cli && pnpm publish",
    "publish:all": "pnpm run publish:core && pnpm run publish:react && pnpm run publish:vue && pnpm run publish:svelte && pnpm run publish:angular && pnpm run publish:tailwind && pnpm run publish:figma && pnpm run publish:cli",
    "publish:ci": "changeset publish",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\" \"examples/**/*.{ts,tsx,js,jsx,json,css,md}\" \"documentation/**/*.{md,vue}\" \"*.{json,md}\""
  },
  "keywords": [
    "design-tokens",
    "theme-engine",
    "theming",
    "css-variables",
    "design-system",
    "theme-switching",
    "runtime-theming",
    "framework-agnostic",
    "react",
    "vue",
    "svelte",
    "typescript",
    "cli",
    "token-parser",
    "token-export",
    "light-dark-theme",
    "dark-mode",
    "light-mode",
    "css-custom-properties",
    "style-dictionary",
    "theme-switcher",
    "design-system-tools",
    "frontend-tooling",
    "ui-theming",
    "color-tokens",
    "spacing-tokens",
    "typography-tokens",
    "accessibility",
    "frontend",
    "developer-tools",
    "angular",
    "nextjs",
    "remix",
    "ssr"
  ],
  "author": "TokiForge Community",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokiForge/tokiforge.git"
  },
  "homepage": "https://www.sachindilshan.com/",
  "bugs": {
    "url": "https://github.com/TokiForge/tokiforge/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.1.0",
    "happy-dom": "^20.3.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "overrides": {
    "svelte": "^5.0.0"
  }
}
