{
    "name": "@tokiforge/astro",
    "version": "2.0.2",
    "description": "Astro integration for TokiForge theming",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "clean": "rm -rf dist"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "peerDependencies": {
        "@tokiforge/core": "workspace:^2.0.2",
        "astro": ">=4.0.0"
    },
    "devDependencies": {
        "astro": "^6.2.1",
        "tsup": "^8.0.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@tokiforge/core": "workspace:^2.0.2"
    },
    "keywords": [
        "astro",
        "theming",
        "design-tokens"
    ],
    "author": "TokiForge Community",
    "license": "AGPL-3.0"
}