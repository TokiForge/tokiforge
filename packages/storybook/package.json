{
  "name": "@tokiforge/storybook",
  "version": "2.3.0",
  "description": "Storybook addon for TokiForge design tokens",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "storybook",
    "addon",
    "design-tokens",
    "tokiforge",
    "theming"
  ],
  "peerDependencies": {
    "@storybook/addons": "^7.0.0 || ^8.0.0",
    "@storybook/api": "^7.0.0 || ^8.0.0",
    "@storybook/components": "^7.0.0 || ^8.0.0",
    "react": "^18.0.0"
  },
  "dependencies": {
    "@tokiforge/core": "workspace:^2.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.14",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^26.1.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "author": "TokiForge Community",
  "license": "AGPL-3.0"
}
