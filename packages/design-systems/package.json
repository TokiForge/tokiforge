{
  "name": "@tokiforge/design-systems",
  "version": "2.3.1",
  "description": "Design system integration tools for TokiForge (Zeroheight, InVision DSM)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./zeroheight": {
      "types": "./dist/zeroheight/index.d.ts",
      "import": "./dist/zeroheight/index.js",
      "require": "./dist/zeroheight/index.cjs"
    },
    "./invision-dsm": {
      "types": "./dist/invision-dsm/index.d.ts",
      "import": "./dist/invision-dsm/index.js",
      "require": "./dist/invision-dsm/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "TokiForge Community",
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@tokiforge/core": "workspace:*",
    "axios": "^1.6.2"
  }
}
