{
  "name": "@tokiforge/vue",
  "version": "3.0.0",
  "description": "Vue adapter for TokiForge theming",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:all": "npm run build",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@tokiforge/core": "workspace:^2.4.0",
    "vue": ">=3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.33"
  },
  "dependencies": {
    "@tokiforge/core": "workspace:^2.4.0"
  },
  "keywords": [
    "vue",
    "theming",
    "design-tokens"
  ],
  "author": "TokiForge Community",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokiForge/tokiforge.git"
  },
  "homepage": "https://github.com/TokiForge/tokiforge#readme",
  "bugs": {
    "url": "https://github.com/TokiForge/tokiforge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
