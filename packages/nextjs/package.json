{
    "name": "@tokiforge/nextjs",
    "version": "2.3.0",
    "description": "Next.js App Router adapter for TokiForge theming",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js",
            "require": "./dist/server.cjs"
        }
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.config.server.ts",
        "build:all": "npm run build",
        "dev": "tsup --watch",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "peerDependencies": {
        "@tokiforge/core": "workspace:^2.3.0",
        "next": ">=14.0.0",
        "react": ">=18.0.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.2.14",
        "@vitest/ui": "^4.1.5",
        "jsdom": "^26.1.0",
        "next": "^16.2.4",
        "react": "^19.2.5",
        "tsup": "^8.0.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    },
    "dependencies": {
        "@tokiforge/core": "workspace:^2.3.0"
    },
    "keywords": [
        "nextjs",
        "next",
        "app-router",
        "theming",
        "design-tokens",
        "rsc"
    ],
    "author": "TokiForge Community",
    "license": "AGPL-3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/TokiForge/tokiforge.git"
    },
    "homepage": "https://github.com/TokiForge/tokiforge#readme",
    "bugs": {
        "url": "https://github.com/TokiForge/tokiforge/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}