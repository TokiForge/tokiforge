{
  "name": "@tokiforge/react",
  "version": "2.0.2",
  "description": "React adapter for TokiForge theming",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "build:all": "npm run build",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist",
    "test": "echo 'React tests skipped - see test file for examples'",
    "test:watch": "echo 'React tests skipped'",
    "test:ui": "echo 'React tests skipped'"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@tokiforge/core": "workspace:^2.0.2",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@vitest/ui": "^4.1.5",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@tokiforge/core": "workspace:^2.0.0"
  },
  "keywords": [
    "react",
    "theming",
    "design-tokens"
  ],
  "author": "TokiForge Community",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TokiForge/tokiforge.git"
  },
  "homepage": "https://github.com/TokiForge/tokiforge#readme",
  "bugs": {
    "url": "https://github.com/TokiForge/tokiforge/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
